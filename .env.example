# Copy this file to .env and replace placeholders.
# Never put real passwords or API keys in this file.
# Never commit .env.

# PostgreSQL (docker compose)
POSTGRES_USER=rag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=permission_aware_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy URLs (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://rag:changeme@localhost:5432/permission_aware_rag
TEST_DATABASE_URL=postgresql+psycopg://rag:changeme@localhost:5432/permission_aware_rag_test

# Qdrant (docker compose). The app connects to this HTTP URL.
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks

# Uploaded files are stored under {organization_id}/{document_id}.
# Relative UPLOAD_ROOT paths resolve from the backend process working directory.
UPLOAD_ROOT=data/uploads

# The Sentence Transformers package and this model must be available locally.
# The model is loaded lazily on first embedding use (upload or question).
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Mock mode is safe for local tests and returns text from an authorized chunk.
# For real generation set LLM_PROVIDER=openai and provide a non-empty API key.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Session cookie (random tokens stored hashed in Postgres; not JWTs)
SESSION_COOKIE_NAME=par_session
SESSION_TTL_HOURS=24
COOKIE_SECURE=false

# CORS / CSRF Origin allowlist (comma-separated, no wildcards)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Signed double-submit CSRF (HMAC key; generate a long random string for real use)
CSRF_COOKIE_NAME=par_csrf
CSRF_SECRET=change-me-to-a-long-random-string
